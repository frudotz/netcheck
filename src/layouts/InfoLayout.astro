---
// Bilgi sayfaları iskeleti (Hakkında, İletişim, Koşullar, Gizlilik) — dil seçici ve sayfa bağlantıları.
// MDX sayfaları özellikleri `frontmatter` ile, .astro sayfaları doğrudan prop olarak iletir.
import Layout from './Layout.astro';
import {
  dirOf, infoHref, INFO_SLUGS, LOCALES, localeName, pageTitle, ui,
} from '../lib/i18n';
import type { InfoSlug, Locale } from '../lib/types';

interface Props {
  lang?: Locale;
  slug?: InfoSlug;
  frontmatter?: { lang?: Locale; slug?: InfoSlug };
}

const lang: Locale = Astro.props.lang ?? Astro.props.frontmatter?.lang ?? 'tr';
const slug: InfoSlug = Astro.props.slug ?? Astro.props.frontmatter?.slug ?? 'hakkinda';
const dir = dirOf(lang);
const t = ui[lang];
---

<Layout title={`${pageTitle[lang][slug]} — NetCheck`} lang={lang} dir={dir}>
  <div class="sayfa okuma">
    <nav class="diller" aria-label={t.language}>
      {LOCALES.map((l) => (
        <a
          href={infoHref(l, slug)}
          lang={l}
          hreflang={l}
          aria-current={l === lang ? 'page' : undefined}
          class:list={{ secili: l === lang }}
        >
          {localeName[l]}
        </a>
      ))}
    </nav>

    <article class="kart icerik">
      <slot />
      <p class="guncelleme">{t.updated}</p>
    </article>

    <nav class="kart diger" aria-label={t.otherPages}>
      <span>{t.otherPages}</span>
      <ul>
        {INFO_SLUGS.filter((s) => s !== slug).map((s) => (
          <li><a href={infoHref(lang, s)}>{pageTitle[lang][s]}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</Layout>

<style>
  .diller {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .diller a {
    display: inline-flex;
    align-items: center;
    min-height: var(--dokunma);
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--kenar);
    border-radius: 999px;
    background: var(--kart);
    font-size: var(--yazi-ince);
    font-weight: 600;
    color: var(--yazi-soluk);
  }

  .diller a.secili {
    border-color: var(--renk-ana);
    background: var(--renk-ana);
    color: var(--renk-ana-yazi);
  }

  .icerik {
    padding: 1.25rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  /* MDX içeriği bileşen kapsamı dışında üretilir; tipografi :global ile verilir. */
  .icerik :global(h1) {
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
    line-height: 1.25;
  }

  .icerik :global(h2) {
    margin: 1.375rem 0 0.375rem;
    font-size: 1.0625rem;
  }

  .icerik :global(p),
  .icerik :global(li) {
    font-size: var(--yazi-orta);
  }

  .icerik :global(ul) {
    margin: 0.375rem 0;
    padding-inline-start: 1.375rem;
  }

  .icerik :global(a) {
    color: var(--renk-ana);
    font-weight: 600;
  }

  .icerik :global(code) {
    font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
    font-size: 0.9em;
    padding: 1px 5px;
    border-radius: 6px;
    background: var(--zemin);
  }

  .guncelleme {
    margin: 1.25rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--kenar);
    font-size: var(--yazi-kucuk) !important;
    color: var(--yazi-soluk);
  }

  .diger {
    padding: 0.875rem var(--bosluk-4);
    font-size: var(--yazi-ince);
  }

  .diger span {
    font-weight: 600;
    color: var(--yazi-soluk);
  }

  .diger ul {
    list-style: none;
    margin: var(--bosluk-2) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--bosluk-2) 1.125rem;
  }

  .diger a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--dokunma);
    min-width: var(--dokunma); /* kısa çeviriler (ör. Farsça "تماس") için de 44 px dokunma alanı */
    font-size: var(--yazi-govde);
    font-weight: 600;
    color: var(--renk-ana);
  }
</style>

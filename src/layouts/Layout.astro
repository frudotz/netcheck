---
import { ClientRouter } from 'astro:transitions';
import AppHeader from '../components/AppHeader.svelte';
import AppNav from '../components/AppNav.svelte';
import '../styles/app.css';

interface Props {
  title?: string;
  // Bilgi sayfaları (görev 06) dil ve yön iletir; varsayılan Türkçe / soldan sağa.
  lang?: string;
  dir?: "ltr" | "rtl";
  // MDX sayfaları (layout: frontmatter) başlığı bu alanla iletir.
  frontmatter?: { title?: string };
}

const { title = Astro.props.frontmatter?.title ?? "NetCheck", lang = "tr", dir = "ltr" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="NetCheck — Yerel Ağ Tanılama ve Bağlantı Analiz Uygulaması" />
    <title>{title}</title>
    <script is:inline>
      // Adım 15: Açılışta renk yanıp sönmesini engellemek için temayı anında uygula
      (() => {
        const uygula = () => {
          document.documentElement.dataset.tema =
            localStorage.getItem("tema") ??
            (matchMedia("(prefers-color-scheme: dark)").matches ? "gece" : "gunduz");
        };
        uygula();
        // ClientRouter gezinmesinde <html> öznitelikleri yeni sayfadan kopyalanır ve data-tema düşer;
        // her sayfa değişiminden sonra tekrar uygulanır (dinleyici bir kez eklenir).
        if (!window.__netcheckTema) {
          window.__netcheckTema = true;
          document.addEventListener("astro:after-swap", uygula);
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <AppHeader client:load />
    <!-- Menü içerikten önce: klavye sırası görsel sırayla aynı (ray solda/sağda; alt menü sabit konumlu). -->
    <AppNav client:load currentPath={currentPath} />
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  /* Uygulama kabuğu — tek kaynak: docs/mimari-agac.md §3.
     Dar ekran: üst başlık + içerik + sabit alt menü.
     Geniş ekran (≥ 64em) veya kısa yatay ekran (telefon yatay): menü içerik yanında dikey ray olur.
     Sütun sırası yazı yönünü izler; RTL'de ray sağa geçer. */
  body {
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr;
  }

  main {
    min-width: 0;
    padding-bottom: calc(var(--alt-menu-yukseklik) + env(safe-area-inset-bottom));
  }

  @media (min-width: 64em), (orientation: landscape) and (min-width: 33em) and (max-height: 31.25em) {
    body {
      grid-template-columns: var(--ray-genislik) minmax(0, 1fr);
      grid-template-areas:
        "ust ust"
        "menu icerik";
    }

    /* Svelte adaları <astro-island> (display: contents) içindedir; ızgara öğesi başlık ve menünün kendisidir. */
    body :global(.ust) {
      grid-area: ust;
    }

    body :global(.alt-menu) {
      grid-area: menu;
    }

    main {
      grid-area: icerik;
      padding-bottom: env(safe-area-inset-bottom);
    }
  }
</style>

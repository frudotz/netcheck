---
import AdminLayout from '../../layouts/AdminLayout.astro';

export function getStaticPaths() {
  const routes = [
    'raporlar',
    'cihazlar',
    'mesajlar',
    'skor-kurallari',
    'hedefler',
    'icerik',
    'yoneticiler',
    'denetim',
    'ayarlar',
  ];

  return routes.map((slug) => ({ params: { slug } }));
}
---

<AdminLayout />
